#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "cleave"

workers = 1
verify = false
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bundle exec cleave [run] [--workers N] [--verify]\n       bundle exec cleave graph --output FILE.html\n       bundle exec cleave ui [--port N] [--no-open]"
  opts.on("--workers N", Integer, "Run the configured full suite in N file workers (default: 1)") { |value| workers = value }
  opts.on("--verify", "Compare a diagnostic preview with the full suite (one worker)") { verify = true }
  opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
end
begin
  if ARGV.first == "ui"
    ARGV.shift
    port = 0
    open_browser = true
    ui_parser = OptionParser.new do |opts|
      opts.banner = "Usage: bundle exec cleave ui [--port N] [--no-open]"
      opts.on("--port N", Integer, "Loopback port (default: an available port)") { |value| port = value }
      opts.on("--no-open", "Print the URL without launching a browser") { open_browser = false }
      opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
    end
    ui_parser.parse!(ARGV)
    raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
    require "cleave/ui_server"
    server = Cleave::UIServer.new(root: Dir.pwd, port: port)
    puts "Cleave workbench: #{server.url}"
    puts "Loopback only; artifact snapshot is incomplete. Press Ctrl-C to stop."
    $stdout.flush
    server.open_browser if open_browser
    server.start
    exit 0
  end
  if ARGV.first == "graph"
    ARGV.shift
    destination = nil
    graph_parser = OptionParser.new do |opts|
      opts.banner = "Usage: bundle exec cleave graph --output FILE.html"
      opts.on("--output FILE", "Write a standalone HTML graph") { |value| destination = value }
      opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
    end
    graph_parser.parse!(ARGV)
    raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
    raise OptionParser::MissingArgument, "--output" unless destination
    inventory, index = Cleave::Artifacts.read(File.join(Dir.pwd, ".cleave"))
    path = Cleave::GraphExport.write(destination, inventory: inventory, index: index)
    puts "Wrote diagnostic graph: #{path} (incomplete index; do not use to skip tests)"
    exit 0
  end
  ARGV.shift if ARGV.first == "run"
  parser.parse!(ARGV)
  raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
  result = Cleave::RSpecRunner.run(root: Dir.pwd, workers: workers, verify: verify)
  puts "\nCleave: #{result['outcome']} · #{result['example_count']} examples · #{result['actual_workers']} worker(s)"
  puts Cleave::Telemetry.render(result)
  warn result["errors"].join("\n") unless result["errors"].empty?
  if verify
    audit = result.fetch("verification")
    puts "Shadow verification: #{audit.fetch('status')} (diagnostic only; suite coverage not verified)"
    puts "Observed missed failure specs: #{audit['observed_missed_failure_specs'].join(', ')}" if audit["observed_missed_failure_specs"]&.any?
    warn audit.fetch("errors", []).join("\n") unless audit.fetch("errors", []).empty?
  end
  exit result.fetch("exit_code")
rescue Interrupt
  warn "Cleave: interrupted"
  exit 130
rescue OptionParser::ParseError, ArgumentError, Cleave::RunnerError, Cleave::ArtifactError, SystemCallError => error
  warn "Cleave: #{error.message}"
  exit 2
end
