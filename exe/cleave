#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "cleave"

workers = 1
verify = false
trace = false
trace_forks = false
index = false
includes = []
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bundle exec cleave [run] [--workers N] [--verify | --trace [--index [--include PATH]]]\n       bundle exec cleave provenance\n       bundle exec cleave plan [--include PATH]\n       bundle exec cleave graph --output FILE.html\n       bundle exec cleave ui [--port N] [--no-open] [--plan [--include PATH]]"
  opts.on("--workers N", Integer, "Run the configured full suite in N file workers (default: 1)") { |value| workers = value }
  opts.on("--index", "Build diagnostic artifacts from this traced run (requires --trace)") { index = true }
  opts.on("--include PATH", "Include an ignored file in the inventory (repeatable; requires --index)") { |value| includes << value }
  opts.on("--trace-forks", "Best-effort observations from forked Ruby children (requires --trace)") { trace_forks = true }
  opts.on("--trace", "Capture incomplete root/example observations in a serial full-suite run") { trace = true }
  opts.on("--verify", "Compare a diagnostic preview with the full suite (one worker)") { verify = true }
  opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
end
begin
  if ARGV.first == "ui"
    ARGV.shift
    port = 0
    open_browser = true
    ui_plan = false
    ui_includes = []
    ui_parser = OptionParser.new do |opts|
      opts.banner = "Usage: bundle exec cleave ui [--port N] [--no-open] [--plan [--include PATH]]"
      opts.on("--port N", Integer, "Loopback port (default: an available port)") { |value| port = value }
      opts.on("--no-open", "Print the URL without launching a browser") { open_browser = false }
      opts.on("--plan", "Compute a diagnostic startup plan (loads specs in RSpec dry-run)") { ui_plan = true }
      opts.on("--include PATH", "Include an ignored current file (requires --plan; repeatable)") { |value| ui_includes << value }
      opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
    end
    ui_parser.parse!(ARGV)
    raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
    require "cleave/ui_server"
    warn "Cleave: computing diagnostic plan; RSpec dry-run loads spec files and may have side effects." if ui_plan
    server = Cleave::UIServer.new(root: Dir.pwd, port: port, plan: ui_plan, includes: ui_includes)
    puts "Cleave workbench: #{server.url}"
    puts "Loopback only; artifact snapshot is incomplete. Press Ctrl-C to stop."
    $stdout.flush
    server.open_browser if open_browser
    server.start
    exit 0
  end
  if ARGV.first == "provenance"
    ARGV.shift
    provenance_parser = OptionParser.new do |opts|
      opts.banner = "Usage: bundle exec cleave provenance"
      opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
    end
    provenance_parser.parse!(ARGV)
    raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
    result = Cleave::IndexProvenance.inspect_pair(root: Dir.pwd)
    puts JSON.pretty_generate(result)
    exit(result["status"] == "recorded" ? 0 : 1)
  end
  if ARGV.first == "plan"
    ARGV.shift
    plan_includes = []
    plan_parser = OptionParser.new do |opts|
      opts.banner = "Usage: bundle exec cleave plan [--include PATH]"
      opts.on("--include PATH", "Include an ignored current file (repeatable)") { |value| plan_includes << value }
      opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
    end
    plan_parser.parse!(ARGV)
    raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
    plan = Cleave::DiagnosticPlan.build(root: Dir.pwd, includes: plan_includes, output: $stderr)
    puts JSON.pretty_generate(plan)
    exit 0
  end
  if ARGV.first == "graph"
    ARGV.shift
    destination = nil
    graph_parser = OptionParser.new do |opts|
      opts.banner = "Usage: bundle exec cleave graph --output FILE.html"
      opts.on("--output FILE", "Write a standalone HTML graph") { |value| destination = value }
      opts.on("-h", "--help", "Show help") { puts opts; exit 0 }
    end
    graph_parser.parse!(ARGV)
    raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
    raise OptionParser::MissingArgument, "--output" unless destination
    inventory, index = Cleave::Artifacts.read(File.join(Dir.pwd, ".cleave"))
    path = Cleave::GraphExport.write(destination, inventory: inventory, index: index)
    puts "Wrote diagnostic graph: #{path} (incomplete index; do not use to skip tests)"
    exit 0
  end
  ARGV.shift if ARGV.first == "run"
  parser.parse!(ARGV)
  raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?
  result = Cleave::RSpecRunner.run(root: Dir.pwd, workers: workers, verify: verify, trace: trace, index: index, includes: includes, trace_forks: trace_forks)
  puts "\nCleave: #{result['outcome']} · #{result['example_count']} examples · #{result['actual_workers']} worker(s)"
  puts Cleave::Telemetry.render(result)
  warn result["errors"].join("\n") unless result["errors"].empty?
  if trace
    capture = result.fetch("trace")
    puts "Trace: #{capture.fetch('status')} · incomplete observations only"
    puts "Fork reports: #{capture.fetch('fork_reports')} (best effort; child coverage unverified)" if capture.key?("fork_reports")
    warn capture["error"] if capture["error"]
  end
  if index
    generated = result.fetch("index")
    puts "Artifacts: #{generated.fetch('status')} · incomplete observations only"
    warn generated["error"] if generated["error"]
  end
  if verify
    audit = result.fetch("verification")
    puts "Shadow verification: #{audit.fetch('status')} (diagnostic only; suite coverage not verified)"
    puts "Observed missed failure specs: #{audit['observed_missed_failure_specs'].join(', ')}" if audit["observed_missed_failure_specs"]&.any?
    warn audit.fetch("errors", []).join("\n") unless audit.fetch("errors", []).empty?
  end
  exit result.fetch("exit_code")
rescue Interrupt
  warn "Cleave: interrupted"
  exit 130
rescue OptionParser::ParseError, ArgumentError, Cleave::RunnerError, Cleave::ArtifactError, Cleave::ParseError, SystemCallError => error
  warn "Cleave: #{error.message}"
  exit 2
end
